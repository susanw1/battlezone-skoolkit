; Padding / reserved growth space between `RotateXZLists` and `SDRAW`.
; This `NOP` run follows a hard `RET` and ends on the next separately built
; module boundary at `0x8C3C`.
i$8C06

; SDRAW
;
; Used throughout gameplay, crash/death, and attract/title/showcase rendering.
;
; .
;
; #PUSHS
; #UDGTABLE
; { #SIM(start=$8C3C,stop=$8C84)#SCR$02(test) }
; UDGTABLE#
; #POPS
@label=SDRAW
c$8C3C LD HL,$DFA0   ;
 $8C3F LD DE,$40A0   ;
 $8C42 LD A,$08      ;
*$8C44 LD BC,$0060   ; Copy one 0x60-byte row from the off-screen status/top-strip bitmap
                     ; (`DFA0..E29F`) into the visible top-strip bitmap at `40A0`; the enclosing
                     ; loop repeats this 8 times to cover the full 768-byte strip.
 $8C47 PUSH HL       ;
 $8C48 PUSH DE       ;
 $8C49 LDIR          ;
 $8C4B POP DE        ;
 $8C4C POP HL        ;
 $8C4D INC D         ;
 $8C4E INC H         ;
 $8C4F DEC A         ;
 $8C50 JP NZ,$8C44   ;
 $8C53 LD HL,$E700   ; Copy the full off-screen lower-playfield bitmap `E700..F6FF` to the visible
                     ; lower two-thirds of the Spectrum bitmap at `4800..57FF`.
 $8C56 LD DE,$4800   ;
 $8C59 LD BC,$1000   ;
 $8C5C LDIR          ;
; This entry point is used by the title flash/fade phase inside `AttractModeTitleSequence`.
; The crash/death path at `0xADD4` temporarily patches this opcode byte to
; `RET` (`0xC9`) and later restores it to `LD HL,nn` (`0x21`) at `0xAE3D`.
*$8C5E LD HL,$DFA0   ;
 $8C61 LD DE,$DFA1   ;
 $8C64 LD A,$08      ;
*$8C66 LD BC,$005F   ; Overlap-fill one 0x60-byte row of the off-screen status/top-strip bitmap
                     ; with zero; the enclosing loop repeats this 8 times to clear all 768 bytes of
                     ; `DFA0..E29F`.
 $8C69 LD (HL),$00   ;
 $8C6B PUSH HL       ;
 $8C6C PUSH DE       ;
 $8C6D LDIR          ;
 $8C6F POP DE        ;
 $8C70 POP HL        ;
 $8C71 INC H         ;
 $8C72 INC D         ;
 $8C73 DEC A         ;
 $8C74 JP NZ,$8C66   ;
 $8C77 LD HL,$E700   ; Clear the full off-screen lower-playfield bitmap `E700..F6FF` (4096 bytes).
 $8C7A LD DE,$E701   ;
 $8C7D LD BC,$0FFF   ;
 $8C80 LD (HL),$00   ;
 $8C82 LDIR          ;
 $8C84 RET           ;

