; Game Entry Point
;
; Primary reset/title entrypoint.
; Disables interrupts, copies the startup seed data into working RAM, and then
; jumps into `AttractModeTitleSequence`.
@label=GameEntryPoint
c$AD0C DI            ; Disable interrupts.
 $AD0D LD HL,$8CA0   ; {Copy 36 bytes of startup seed data from #R$8CA0 to #R$F700.
 $AD10 LD DE,$F700   ;
 $AD13 LD BC,$0024   ;
 $AD16 LDIR          ; }
 $AD18 JP $B1F4      ; Jump to #R$B1F4.

