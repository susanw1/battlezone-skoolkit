; Print Characters
;
; Used by the routines at #R$B55D and #R$B676.
;
; HL Address of text
; B Number of characters to print
@label=PrintCharacters
c$B66C LD A,(HL)     ; Load the next character from the text pointer in `HL`.
 $B66D PUSH HL       ; {Stash the string pointer and character counter on the
 $B66E PUSH BC       ; stack.}
 $B66F RST $10       ; Print the character to the screen.
 $B670 POP BC        ; {Restore the character counter and string pointer from
 $B671 POP HL        ; the stack.}
 $B672 INC HL        ; Increment the string pointer by one to point to the next
                     ; character.
 $B673 DJNZ $B66C    ; Decrease the character counter by one and loop back to
                     ; #R$B66C until all characters have been printed.
 $B675 RET           ; Return.

