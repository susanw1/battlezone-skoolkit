; MESPR
;
; HL Address of a rectangle descriptor: destination, height, width, then row-major byte data
; Current best shipped read: generic message/rectangle blitter for the status
; strip and small HUD warning areas.
; Descriptor format:
; - bytes 0..1: destination address
; - byte 2: height in character rows
; - byte 3: width in bytes
; - remaining bytes: row-major source data copied into the destination
; Each row advances by the Spectrum character-row stride (`+0x20`).
;
; HL Address of rectangle descriptor: destination, height, width, then
; .  row-major byte data
@label=MESPR
c$9452 LD E,(HL)     ; Load the destination address low byte.
 $9453 INC HL        ;
 $9454 LD D,(HL)     ; Load the destination address high byte.
 $9455 INC HL        ;
 $9456 LD C,(HL)     ; Load the rectangle height.
 $9457 INC HL        ;
 $9458 LD B,(HL)     ; Load the rectangle width.
 $9459 INC HL        ;
 $945A LD A,B        ; Stash the width in the alternate register set.
 $945B EX AF,AF'     ;
 $945C LD A,E        ; Stash the starting column too.
 $945D EXX           ;
 $945E LD C,A        ;
 $945F EX AF,AF'     ;
 $9460 LD B,A        ;
 $9461 EXX           ;
*$9462 LD A,(HL)     ; Copy one row of rectangle data.
 $9463 INC HL        ;
 $9464 LD (DE),A     ;
 $9465 INC E         ;
 $9466 DJNZ $9462    ;
 $9468 EXX           ; Restore the start column and width for the next row.
 $9469 LD A,B        ;
 $946A EX AF,AF'     ;
 $946B LD A,C        ;
 $946C EXX           ;
 $946D LD E,A        ;
 $946E EX AF,AF'     ;
 $946F LD B,A        ;
 $9470 INC D         ; Advance to the next character row.
 $9471 DEC C         ;
 $9472 JP NZ,$9462   ;
 $9475 RET           ;

; MESER
;
; HL Address of a rectangle descriptor: destination, height, width
; Current best shipped read: companion rectangle eraser for `MESPR`.
; Uses the same descriptor header (`destination`, `height`, `width`) but fills
; the target rectangle with zero bytes instead of copying source data.
; Each row advances by the Spectrum character-row stride (`+0x20`).
;
; HL Address of rectangle descriptor: destination, height, width
@label=MESER
c$9476 LD E,(HL)     ; Load the destination address low byte.
 $9477 INC HL        ;
 $9478 LD D,(HL)     ; Load the destination address high byte.
 $9479 INC HL        ;
 $947A LD C,(HL)     ; Load the rectangle height.
 $947B INC HL        ;
 $947C LD B,(HL)     ; Load the rectangle width.
 $947D LD H,E        ; Preserve the starting column in HL.
 $947E LD L,B        ; Preserve the width in HL.
 $947F SUB A         ; Fill with zero bytes.
*$9480 LD (DE),A     ;
 $9481 INC E         ;
 $9482 DJNZ $9480    ;
 $9484 INC D         ; Advance to the next character row.
 $9485 LD E,H        ; Restore the starting column.
 $9486 LD B,L        ; Restore the width.
 $9487 DEC C         ;
 $9488 JP NZ,$9480   ;
 $948B RET           ;

; Plot Number Glyph
;
; A Digit or symbol index
; BC Destination address
; Current best shipped read: generic 7-row status-strip glyph renderer reused by
; `NUMBA`, life-strip redraws, and a few attract/title overlays.
; The low nibble of `A` selects an 8-byte slot in `NumberGlyphs`; only the first
; 7 rows are copied, then `BC` is advanced one column so callers can chain glyph
; plots horizontally without adjusting the destination themselves.
;
;   A Digit or symbol index; the low nibble selects the glyph slot
;   BC Destination address
; O:BC Destination advanced one column to the right for chained glyph plots
@label=PlotNumberGlyph
c$948C PUSH BC                              ; Preserve the destination pointer for the caller.
 $948D AND $0F                              ; Keep only the low nibble.
 $948F RLCA                                 ; Multiply by eight to index 8-byte glyphs.
 $9490 RLCA                                 ;
 $9491 RLCA                                 ;
 $9492 LD D,B                               ; Move the destination address into DE.
 $9493 LD E,C                               ;
 $9494 LD HL,$CD80                          ; NumberGlyphs
 $9497 ADD A,L                              ;
 $9498 LD L,A                               ;
 $9499 LD B,$07                             ; Copy the 7 visible rows of the glyph.
*$949B LD A,(HL)                            ;
 $949C LD (DE),A                            ;
 $949D INC HL                               ;
 $949E INC D                                ;
 $949F DJNZ $949B                           ;
 $94A1 POP BC                               ; Advance to the next screen column for chained calls.
 $94A2 INC BC                               ;
 $94A3 RET                                  ;
 $94A4 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;

; SCOPR
;
; B Score increment in packed BCD
; Current best shipped read: shared packed-BCD score updater with inlined
; extra-life handling.
; Adds the increment in `B` to `ScoreBCD`, compares the result against the next
; extra-life threshold at `0xFEE6`, awards a life if needed, doubles that next
; threshold, redraws one life symbol pair if the strip is not yet full, then
; falls through into `NUMBA` to refresh the visible score display.
;
; B Packed-BCD score increment
@label=SCOPR
c$94AC LD HL,($FE76) ; Load the current score.
 $94AF LD A,B        ;
 $94B0 ADD A,L       ; Add the score increment to the low BCD byte.
 $94B1 DAA           ;
 $94B2 LD L,A        ;
 $94B3 JR NC,$94BA   ;
 $94B5 LD A,H        ; Carry into the high BCD byte.
 $94B6 ADD A,$01     ;
 $94B8 DAA           ;
 $94B9 LD H,A        ;
*$94BA LD DE,($FEE6) ; Compare with the next extra-life threshold.
 $94BE PUSH HL       ;
 $94BF SBC HL,DE     ;
 $94C1 JP M,$94EB    ;
 $94C4 LD A,($FEE4)  ; Award an extra life and double the next threshold.
 $94C7 INC A         ;
 $94C8 LD ($FEE4),A  ;
 $94CB SLA E         ;
 $94CD RL D          ;
 $94CF LD ($FEE6),DE ;
 $94D3 CP $08        ; Stop drawing life symbols once the strip is full.
 $94D5 JR NC,$94EB   ; Compute the destination column for the newly awarded life symbol pair in the
                     ; top status strip.
 $94D7 LD BC,$4010   ; Base destination `$4010` is the left edge of the life-symbol strip.
 $94DA LD L,A        ;
 $94DB LD H,$00      ;
 $94DD ADD HL,HL     ;
 $94DE ADD HL,BC     ;
 $94DF LD B,H        ;
 $94E0 LD C,L        ;
 $94E1 LD A,$0A      ;
 $94E3 CALL $948C    ;
 $94E6 LD A,$0B      ;
 $94E8 CALL $948C    ;
*$94EB POP HL        ;

