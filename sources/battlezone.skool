 $8664 LD ($FE40),A  ;
 $8667 LD SP,($FE38) ;
 $866B EXX           ;
 $866C LD HL,($FE32) ;
 $866F LD DE,($FE36) ;
 $8673 LD B,$84      ;
 $8675 EXX           ;
