 $B1F0
 $B1F1 JP NZ,$B1D9

; Routine at B1F4
;
; Used by the primary entrypoint, gameplay abort/back-to-title paths, and the instructions loop.
; Current best read: attract-mode stage A/B.
; It clears the screen, prepares title/demo resources, runs the tumbling
; title/logo animation blocks, and checks `S` at multiple points so the player
; can break straight into the common start-game transition at #R$B0BC.
@label=AttractModeTitleSequence
c$B1F4 LD A,$12      ; {FLASH: OFF.
 $B1F6 RST $10       ;
 $B1F7 SUB A         ;
 $B1F8 RST $10       ; }
 $B1F9 LD A,$13      ; {BRIGHT: ON.
 $B1FB RST $10       ;
 $B1FC LD A,$01      ;
 $B1FE RST $10       ; }
 $B1FF LD A,$14      ; {INVERSE: OFF.
 $B201 RST $10       ;
 $B202 SUB A         ;
 $B203 RST $10       ; }
 $B204 LD A,$15      ; {OVER: OFF.
 $B206 RST $10       ;
 $B207 SUB A         ;
 $B208 RST $10       ; }
 $B209 CALL $8000    ; Call #R$8000.
 $B20C LD HL,$4000   ; {Write `0x00` to the full 6144-byte visible bitmap (`0x4000..0x57FF`).
 $B20F LD DE,$4001   ;
 $B212 LD BC,$17FF   ;
 $B215 LD (HL),$00   ;
 $B217 LDIR          ; }
 $B219 LD HL,$5800   ; {Write `0x44` to the full 768-byte attribute buffer
 $B21C LD DE,$5801   ; (`0x5800..0x5AFF`) = bright green ink on black paper, no flash.
 $B21F LD (HL),$44   ;
 $B221 LD BC,$02FF   ;
 $B224 LDIR          ; }
 $B226 LD HL,$FE00   ; {Clear the 256-byte workspace block from #R$FE00 through `$FEFF`.
 $B229 LD DE,$FE01   ;
 $B22C LD (HL),$00   ;
 $B22E LD BC,$00FF   ;
 $B231 LDIR          ; }
 $B233 LD HL,$C8B4   ; {#HTML(Install the custom Battlezone character set by writing #R$C9B4(`$C8B4`)
 $B236 LD ($5C36),HL ; to *<a rel="noopener nofollow"
                     ; href="https://skoolkit.ca/disassemblies/rom/hex/asm/5C36.html">CHARS</a>.)
                     ; }
 $B239 LD HL,$6400   ; {Write `$6400` to *#R$FE60.
 $B23C LD ($FE60),HL ; }
 $B23F LD HL,$0000   ; {Write `$0000` to both #R$FE5E and #R$FE62.
 $B242 LD ($FE5E),HL ;
 $B245 LD ($FE62),HL ; }
 $B248 LD A,$30      ; {Write `$30` to *#R$FE68.
 $B24A LD ($FE68),A  ; }
